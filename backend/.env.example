PORT=5000
NODE_ENV=development

# AI Provider Settings
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# PayPal Sandbox Credentials (REST API)
# Obtain these from developer.paypal.com -> Dashboard -> Apps & Credentials
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=

# Supabase Database Configuration (Optional, falls back to persistent local store if not configured)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Default Currency (USD or INR - Note: PayPal Sandbox default is USD)
DEFAULT_CURRENCY=USD
